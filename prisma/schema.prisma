generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  CONTENT_CREATOR
  BRANCH_MANAGER
  READ_ONLY
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  CONTACTED
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum GalleryAlbumType {
  EVENTS
  PRODUCTS
  SMART_FARM
  BRANCHES
  FARMERS
}

enum SmartFarmSectionType {
  DEMO_FARM
  GREENHOUSE
  DAIRY
  POULTRY
}

// ---------- Core / Auth ----------

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  activityLogs ActivityLog[]
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------- Branches ----------

model Branch {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  address   String?
  lat       Float?
  lng       Float?
  phone     String?
  whatsapp  String?
  email     String?
  hours     String?
  photo     String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

// ---------- Products ----------

model ProductCategory {
  id       String            @id @default(cuid())
  name     String
  slug     String            @unique
  parentId String?
  parent   ProductCategory?  @relation("CategoryToSub", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryToSub")
  order    Int               @default(0)
  products Product[]
}

model Product {
  id                String          @id @default(cuid())
  name              String
  slug              String          @unique
  categoryId        String?
  category          ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images            String[]
  description       String?
  price             Decimal?        @db.Decimal(12, 2)
  manufacturer      String?
  usageInstructions String?
  brochureUrl       String?
  stockStatus       StockStatus     @default(IN_STOCK)
  isFeatured        Boolean         @default(false)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  orderItems OrderItem[]
  reviews    Review[]

  @@index([categoryId])
}

// ---------- Services ----------

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  icon        String?
  image       String?
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------- Smart Farm ----------

model SmartFarmSection {
  id          String               @id @default(cuid())
  title       String
  type        SmartFarmSectionType
  description String?
  images      String[]
  videos      String[]
  order       Int                  @default(0)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

// ---------- Events ----------
// Status (Upcoming/Ongoing/Past) is intentionally NOT stored — it's derived
// at query time from startDate/endDate vs now(), so there is nothing to
// keep in sync and no cron job required.

model Event {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  description       String?
  venue             String?
  startDate         DateTime
  endDate           DateTime
  coverImage        String?
  gallery           String[]
  videoUrl          String?
  registrationLink  String?
  organizer         String?
  category          String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([startDate, endDate])
}

// ---------- Gallery ----------

model GalleryAlbum {
  id         String           @id @default(cuid())
  title      String
  type       GalleryAlbumType
  coverImage String?
  order      Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  media      GalleryMedia[]
}

model GalleryMedia {
  id      String       @id @default(cuid())
  albumId String
  album   GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url     String
  type    MediaType    @default(IMAGE)
  caption String?
  order   Int          @default(0)

  @@index([albumId])
}

// ---------- Testimonials & Success Stories ----------

model Testimonial {
  id         String   @id @default(cuid())
  name       String
  role       String?
  photo      String?
  quote      String
  rating     Int?
  isFeatured Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model SuccessStory {
  id           String   @id @default(cuid())
  title        String
  farmerName   String
  beforeImage  String?
  afterImage   String?
  video        String?
  body         String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------- Downloads ----------

model Download {
  id        String   @id @default(cuid())
  title     String
  category  String?
  fileUrl   String
  fileType  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ---------- Newsletter & Contact ----------

model Subscriber {
  id            String   @id @default(cuid())
  email         String   @unique
  isActive      Boolean  @default(true)
  subscribedAt  DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  branchId  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------- Site Settings ----------
// Generic key/value JSON store backing homepage sections, theme, logos,
// social links, contact info, floating widgets, SEO defaults, analytics IDs
// so admins can edit "every page" without a bespoke table per setting.

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------- Partners ----------

model Partner {
  id        String   @id @default(cuid())
  name      String
  logo      String
  website   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ---------- Orders ----------
// Order intake/lead flow, not a payment checkout: a visitor submits a cart,
// admin follows up by phone/email to confirm availability and payment.

model Order {
  id           String      @id @default(cuid())
  customerName String
  phone        String
  email        String?
  branchId     String?
  branch       Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  notes        String?
  status       OrderStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Int
  price       Decimal? @db.Decimal(12, 2)

  @@index([orderId])
}

// ---------- Reviews ----------
// Per-product reviews, distinct from the site-wide Testimonial model.
// isApproved gates public visibility until an admin moderates it.

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName String
  rating     Int
  comment    String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId])
}
